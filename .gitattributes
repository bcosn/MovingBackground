# ===========================================================================
#  git 属性 —— 保证别人 clone 下来就能直接编译
#
#  这个项目对"编码"和"换行符"都很敏感，所以规则写明确：
#
#  1) 源码是 UTF-8 **无 BOM** + LF，靠编译器参数 /utf-8 正确解析中文。
#     git 只转换换行、不转换编码，所以这里固定成 LF 就好。
#     （MSVC 和 MinGW 都能正确处理 LF 换行的 C++ 源码）
#
#  2) .bat 必须是 CRLF：cmd.exe 解析 LF-only 的批处理文件时，
#     在 goto 标签和带括号的 if 块上有已知问题。build.bat 两样都用了，
#     所以强制 CRLF 最保险。
# ===========================================================================

* text=auto

# ---- 源码：UTF-8 无 BOM，LF ----
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.c     text eol=lf

# ---- 批处理脚本：必须 CRLF ----
*.bat   text eol=crlf
*.cmd   text eol=crlf

# ---- 文档 / 配置 ----
*.md    text eol=lf
*.txt   text eol=lf
*.ini   text eol=crlf
*.yml   text eol=lf
*.yaml  text eol=lf

# ---- 图片与二进制：禁止任何转换 ----
*.jpg   binary
*.jpeg  binary
*.png   binary
*.bmp   binary
*.gif   binary
*.tif   binary
*.ico   binary
*.exe   binary

# ---- 元文件：固定 LF，避免 checkout 时被转成 CRLF ----
.gitattributes text eol=lf
.gitignore     text eol=lf
LICENSE        text eol=lf